{
  "name": "maxflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "check": "bun scripts/check.ts && bun test",
    "check:full": "bun scripts/check.ts && bun scripts/typecheck.ts && bun --bun eslint --max-warnings 0 --pass-on-unpruned-suppressions . && bun scripts/baseline-shrinks.ts && bun test",
    "typecheck": "bun scripts/typecheck.ts",
    "lint": "bun --bun eslint --max-warnings 0 --pass-on-unpruned-suppressions .",
    "lint:shrink": "rm -f eslint-suppressions.json && bun --bun eslint --suppress-all . ; bun scripts/typecheck.ts --shrink"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-clipboard": "0.1.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "bun-plugin-tailwind": "^0.1.2",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "html-to-image": "1.11.11",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "20",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/scope-manager": "8.73.0",
    "@typescript-eslint/utils": "8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0"
  }
}
