#!/bin/sh
# yarn's merge gate for agent panes, behind the PreToolUse hook: it also catches a merge run from a script the hook never reads
here=$(cd "$(dirname "$0")" && pwd)
# constraint: panes started before the rename to yarn carry only MAXFLOW_*
state=${YARN_STATE:-$MAXFLOW_STATE}
gate_is_on() {
  [ -n "$state" ] && grep -Eq '"on" *: *true' "$state/merge-gate.json" 2>/dev/null
}
refuse() {
  gate_is_on || return 0
  echo "gh: blocked by yarn's merge gate: Isaac has it on, so he is the last step before any PR merges and no agent merges a PR or arms auto-merge. It is his switch alone (the PRs tab, or Restrictions). Leave the PR green and approved; he merges it." >&2
  exit 1
}
if [ "$1" = pr ] && [ "$2" = merge ]; then
  case " $* " in *" --disable-auto "*) ;; *) refuse ;; esac
fi
if [ "$1" = api ]; then
  for arg in "$@"; do
    case "$arg" in
      *mergePullRequest*|*enablePullRequestAutoMerge*|*enqueuePullRequest*|*mergeBranch*) refuse ;;
      *pulls/*/merge|*pulls/*/merge\?*|*/merges) refuse ;;
    esac
  done
fi
IFS=:
for dir in $PATH; do
  [ "$dir" = "$here" ] && continue
  [ -x "$dir/gh" ] && exec "$dir/gh" "$@"
done
echo "gh: not found on PATH" >&2
exit 127
